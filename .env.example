# AI UniPod Lagos - Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ─── ADMIN AUTHENTICATION ────────────────────────────────────
# Generate a secure password hash using: echo -n "your-password" | sha256sum
ADMIN_EMAIL=admin@unipod.unilag.edu.ng
ADMIN_PASSWORD_HASH=your-sha256-hash-here

# Generate a random JWT secret using: openssl rand -hex 32
JWT_SECRET=your-random-jwt-secret-here

# ─── SUPABASE CONFIGURATION ──────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── SECURITY SETTINGS ───────────────────────────────────────
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://unipod.unilag.edu.ng,https://www.unipod.unilag.edu.ng

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ─── DEPLOYMENT ──────────────────────────────────────────────
NODE_ENV=production
