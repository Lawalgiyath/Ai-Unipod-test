{
  "version": 2,
  "public": true,
  "github": {
    "silent": true
  },
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/images/(.*)",
      "destination": "https://raw.githubusercontent.com/Lawalgiyath/Ai-Unipod-test/main/frontend/images/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}


